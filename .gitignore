# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# NOTE: this is `addons/*`, not `addons/`, and the difference is load-bearing.
# `addons/` excludes the addons DIRECTORY, and git cannot re-include a file whose
# parent directory is excluded - so a `!addons/libik/...` rule placed under it is
# silently dead and every re-inclusion below is a no-op. `addons/*` excludes the
# CONTENTS while leaving the directory itself re-includable. Verified behaviourally
# with git check-ignore, not by reading the rules.
addons/*
assets/models/weapon_thirty_twelve/

# GodotIK: the GDExtension DESCRIPTOR is source and is tracked, because without it
# a fresh checkout cannot know the extension exists at all. The compiled binaries
# under bin/ stay ignored on purpose - ~17MB of platform-locked native code that a
# fetch-and-build reproduces, and committing them buries real changes in an
# unreviewable binary diff.
!addons/libik/
addons/libik/*
!addons/libik/libik.gdextension
!addons/libik/libik.gdextension.uid

# Local agent message queue (AMQ maildir, per-machine scratch)
.agent-mail/

# Agent Message Queue
.agent-mail/
.amqrc

# Local Laya decision-model weights (large, fetched per-machine)
laya-models/

# glTF embedded-texture extraction output (Godot writes these on every cold
# import of the model, as <glb_stem>_<image_name>.png next to the .glb).
# Listed one path per line, never as a glob, so authored art whose name happens
# to contain underscores stays visible to git. Each is a byte-identical
# duplicate of a tracked texture, so nothing references these copies:
#   scope_Material_albedo.png      == assets/models/weapon_aglc/scope_material.png
#   PSX_Battle_Rifle_T_Battle.png  == assets/models/weapon_battle_rifle/PSX_Battle_Rifle_T_Battle_Rifle.png
# (md5 955fa408d8b72bc8c3af0f9a43e57038 and 7c75d2d5831bc31f188940a5c424cdf3)
# Note: this hides the files from `git status`; it does NOT stop Godot from
# writing them or from packing them into an export.
assets/models/weapon_aglc/scope_Material_albedo.png
assets/models/weapon_aglc/scope_Material_albedo.png.import
assets/models/weapon_battle_rifle/PSX_Battle_Rifle_T_Battle.png
assets/models/weapon_battle_rifle/PSX_Battle_Rifle_T_Battle.png.import
