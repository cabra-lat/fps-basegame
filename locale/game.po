# Portuguese (Brazil) catalogue for the shipped UI.
# msgid is always the ENGLISH source string, exactly as it appears in code; the
# code never carries a translated literal. English stays readable in the source
# tree and pt_BR ships here. A missing msgstr is not a silent fallback: the
# i18n harness (src/meta/validate_i18n.gd) fails when a key is untranslated.
msgid ""
msgstr ""
"Project-Id-Version: fps-basegame\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

